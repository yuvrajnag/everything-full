# ─────────────────────────────────────────────────────────────────────────
# Frontend environment (Next.js)
# Copy to .env.local and fill in. Never commit the real env file.
# ─────────────────────────────────────────────────────────────────────────

# ── Backend ─────────────────────────────────────────────────────────────
# Base URL of the Express API, including the /api prefix.
# Only read server-side (in the proxy route and server components).
NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# Shared secret injected by the proxy. MUST match INTERNAL_API_KEY in backend/.env.
INTERNAL_API_KEY=""

# ── Auth (NextAuth + Google OAuth) ──────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# The site's canonical URL. Required in production; inferred locally.
NEXTAUTH_URL="http://localhost:3000"

# From https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Payments ────────────────────────────────────────────────────────────
# Razorpay *publishable* key id — same value as RAZORPAY_KEY_ID in the backend.
# This one is safe to expose to the browser; the secret must never be here.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── Database (NextAuth Prisma adapter only) ─────────────────────────────
# Same database as the backend.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"
