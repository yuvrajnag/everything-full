# ─────────────────────────────────────────────────────────────────────────
# Backend environment (Express + Prisma)
# Copy to .env and fill in. Never commit the real .env.
# ─────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────
# Pooled connection (PgBouncer) used at runtime.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Direct connection used by `prisma migrate` / `prisma db push`.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Shared secret the Next.js proxy injects as `x-internal-secret`.
# MUST match INTERNAL_API_KEY in frontend/.env. Generate with:
#   openssl rand -base64 32
# Required in production; falls back to a dev default locally.
INTERNAL_API_KEY=""

# ── Payments (Razorpay) ─────────────────────────────────────────────────
# Get test-mode keys from https://dashboard.razorpay.com/app/website-app-settings/api-keys
# Leave empty to run the store with Cash on Delivery only — card and UPI
# checkout will then be rejected with a clear, customer-facing message.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Optional: only needed if you configure Razorpay webhooks.
RAZORPAY_WEBHOOK_SECRET=""

# ── Optional ────────────────────────────────────────────────────────────
# Redis backs the product cache, checkout idempotency and rate limiting.
# If unset or unreachable the store still works, with local-memory fallbacks.
REDIS_URL="redis://localhost:6379"

# Comma-separated browser origins allowed by CORS. Required in production.
ALLOWED_ORIGINS="http://localhost:3000"

PORT="5000"
NODE_ENV="development"
LOG_LEVEL="info"
